# キーが揃うまでは全て mock のままで、UI からデモまで一通り動きます。
# 実 API に切り替えるときは該当行を live にして、対応するキーを入れてください。

GEMINI_MODE=mock
YOUCAM_MODE=mock
EKISPERT_MODE=mock
SPEECH_MODE=mock

# firestore（既定：開発はエミュレータ、本番は GCP）／ memory（テスト用）
DB_DRIVER=firestore
# local（/data/storage）／ gcs
STORAGE_DRIVER=local

GOOGLE_CLOUD_PROJECT=omoide-kobo-local
GCS_BUCKET=

GEMINI_API_KEY=
# 画像入力に対応した最新の Flash。軽くしたいときは gemini-3.5-flash-lite など
GEMINI_MODEL=gemini-3.7-flash
YOUCAM_API_KEY=
YOUCAM_SECRET_KEY=
EKISPERT_MCP_URL=

