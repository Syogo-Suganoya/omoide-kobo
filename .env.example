# キーが揃うまでは全て mock のままで、UI からデモまで一通り動きます。
# 実 API に切り替えるときは該当行を live にして、対応するキーを入れてください。

GEMINI_MODE=mock
EKISPERT_MODE=mock

# firestore（既定：開発はエミュレータ、本番は GCP）／ memory（テスト用）
DB_DRIVER=firestore
# Firestore のデータベース ID。エミュレータは (default) のまま。
# 本番で --database を付けて作ったなら、その名前に合わせる
FIRESTORE_DATABASE=(default)
# local（/data/storage）／ gcs
STORAGE_DRIVER=local

GOOGLE_CLOUD_PROJECT=omoide-kobo-local
GCS_BUCKET=

GEMINI_API_KEY=
# 画像入力に対応した最新の Flash。軽くしたいときは gemini-3.5-flash-lite など
GEMINI_MODEL=gemini-3.5-flash
# 駅すぱあと API のアクセスキー（90日無料評価版でも可）。MCP サーバーへヘッダで渡す
EKISPERT_API_KEY=
# 既定で公式エンドポイントを見るので、通常は空のままでよい
EKISPERT_MCP_URL=https://api-mcp.ekispert.jp/mcp
# ダイヤ探索（departure など）は専用アクセスキーが要る。通常のキーでは plain のみ通る
EKISPERT_SEARCH_TYPE=plain

