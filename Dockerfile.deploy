# Cloud Run 用の 1 コンテナ構成（API + ビルド済み PWA）。
# ビルド: docker build -f Dockerfile.deploy -t omoide-kobo .
FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libjpeg62-turbo zlib1g \
    && rm -rf /var/lib/apt/lists/*

# 解決済みのロックをそのまま入れる（--no-deps なので pip は依存解決を一切しない）。
# ロックの作り直しは `docker compose run --rm lock`。
COPY backend/requirements-lock.txt ./
RUN pip install --no-cache-dir --no-deps -r requirements-lock.txt

COPY backend/ ./
COPY --from=web /web/dist ./static

RUN mkdir -p /data/storage
ENV STORAGE_LOCAL_ROOT=/data/storage PORT=8080
EXPOSE 8080
# Cloud Run が渡す $PORT を展開する必要があるので sh 経由。exec でシグナルを uvicorn に届ける
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
